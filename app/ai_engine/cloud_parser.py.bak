"""
Cloud Parsing — Gemini 2.5 Flash untuk OCR vision + validasi logika.
Jika API key kosong atau Ollama lokal sudah cukup, return NEED_REVIEW.
"""
import json
import logging
import base64
from pathlib import Path
from app.core.config import settings

logger = logging.getLogger(__name__)

GEMINI_MODEL = "gemini-2.5-flash"

def validate_with_gemini(kuitansi_payload: dict, image_path: str = None) -> dict:
    if not settings.GEMINI_API_KEY or settings.GEMINI_API_KEY.startswith("GANTI"):
        return {"status": "NEED_REVIEW", "reason": "GEMINI_DISABLED", "sintaks_ok": None}

    try:
        import google.generativeai as genai
        genai.configure(api_key=settings.GEMINI_API_KEY)
        model = genai.GenerativeModel(GEMINI_MODEL)

        # Jika ada foto, kirim image langsung ke Gemini (vision multimodal)
        parts = []
        if image_path and Path(image_path).exists():
            img_data = Path(image_path).read_bytes()
            mime = "image/jpeg" if image_path.lower().endswith((".jpg", ".jpeg")) else "image/png"
            parts.append({"mime_type": mime, "data": img_data})
            ocr_task = (
                "Baca foto amplop persembahan GMAHK UKIKT ini. "
                "Tulisan tangan. Ekstrak JSON: "
                "{\"nama_umat\":\"...\",\"perpuluhan_X_angka\":0,\"PT_angka\":0,\"total_huruf\":\"...\"}. "
                "Output HANYA JSON object tanpa markdown."
            )
            parts.append(ocr_task)
        else:
            # Pure numeric validation (legacy fallback)
            parts.append(
                "Kamu auditor numerik GMAHK. Periksa JSON kuitansi ini:\n"
                f"{json.dumps(kuitansi_payload, default=str)}\n\n"
                "Validasi: total_pemberian_angka == perpuluhan_X_angka + PT_angka? "
                "Apakah angka konsisten dengan total_pemberian_huruf? "
                "Balas JSON: {\"status\":\"VALID_MATCH\"|\"NEED_REVIEW\",\"alasan\":\"...\"}"
            )

        resp = model.generate_content(parts)
        text = resp.text or ""
        start, end = text.find("{"), text.rfind("}")
        if start == -1 or end == -1:
            return {"status": "NEED_REVIEW", "reason": "GEMINI_PARSE_FAIL", "raw": text[:300]}
        parsed = json.loads(text[start:end + 1])

        # Normalisasi output
        if "nama_umat" in parsed:
            # This was an OCR result — return as-is plus VALID_MATCH if numbers make sense
            x = int(parsed.get("perpuluhan_X_angka") or 0)
            pt = int(parsed.get("PT_angka") or 0)
            if x + pt > 0:
                return {"status": "VALID_MATCH", "ocr": parsed, "sintaks_ok": True}
            return {"status": "NEED_REVIEW", "ocr": parsed, "sintaks_ok": False, "reason": "ZERO_TOTAL"}
        return parsed
    except Exception as exc:
        logger.warning("Gemini error: %s", exc)
        return {"status": "NEED_REVIEW", "reason": "GEMINI_UNREACHABLE", "detail": str(exc)}
