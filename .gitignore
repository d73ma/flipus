# FLIPUS — Root gitignore

# Environment & secrets
.env
.env.*
!.env.example
.env.bak.*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
.venv.broken314/
venv/
ENV/
env/

# Database
*.db
*.sqlite
*.sqlite3
*.db-journal
flipus_local.db
flipus_local.db-journal
flipus_local.db.bak.*
postgres_data/
*.sql.gz

# Logs
*.log
storage/logs/
!storage/logs/.gitkeep

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
*.xml

# OS
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Backups (security-sensitive!)
storage/backups/
*.tar.gz
*.tar
*.gpg

# Storage runtime
storage/ssl/
storage/uploads/
storage/scripts/*.bak
/tmp/

# Build artifacts
frontend/dist/
frontend/build/
node_modules/

# Audit logs (may contain sensitive PII traceability)
storage/audit-dumps/

# Type-check / lint caches (FASE 3 Sprint 4)
.mypy_cache/
.ruff_cache/

# FASE 5 Sprint 4 — temp scripts & backups from ruff sweep iterations.
# Kept locally for debugging; never tracked.
.tmp_ruff/
.tmp_ruff/**/
.ruff_e402_fix.py

# FASE 5 Sprint 6 — Tenant branding uploads (testing artifacts).
# These are uploaded via /settings/branding for white-label per tenant.
# Real production uploads should NOT be tracked — only DB rows matter.
storage/tenants/*/logo_*.png
storage/tenants/*/logo_*.svg
storage/tenants/*/logo_*.jpg
storage/tenants/*/logo_*.jpeg
