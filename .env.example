# FLIPUS v1.2 — Environment variables
# Copy file ini ke .env lalu isi nilai yang sesuai

# ===== Security =====
# Generate dengan: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=ganti-dengan-random-string-min-32-char
PII_ENCRYPTION_KEY=ganti-dengan-fernet-key-dari-fernet.generate_key

# ===== Database =====
# Default SQLite untuk jemaat lokal
DATABASE_URL_LOCAL=sqlite:///./flipus_local.db
# Optional PostgreSQL untuk Kantor Misi/Uni
# DATABASE_URL_LOCAL=postgresql://flipus:flipus@postgres:5432/flipus
DATABASE_URL_CLOUD=postgresql://flipus:flipus@postgres:5432/flipus

# ===== WhatsApp (Fonnte) =====
# Daftar di https://fonnte.com, ambil token dari dashboard
FONNTE_TOKEN=your-fonnte-token-here
WA_API_URL=https://api.fonnte.com/send

# ===== AI (Gemini untuk OCR) =====
GEMINI_API_KEY=your-gemini-api-key-here

# ===== License =====
LICENSE_TENANT_SIGNATURE_SALT=UKIKT_FLIPUS_2026_NATAAN_RATAHAN_SALT

# ===== Application =====
DEFAULT_UNI=Uni Konferens Indonesia Kawasan Timur (UKIKT)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# ===== Logging (FASE 3-S3.S1) =====
# Log level untuk root logger. Valid: DEBUG, INFO, WARNING, ERROR.
# Default INFO. Set DEBUG untuk development verbose (lihat app/core/logger.py).
# LOG_LEVEL=INFO

# ===== CORS (FASE 3-S3.S3) =====
# Comma-separated list of allowed origins.
# Default (dev): localhost Vite + alternative dev ports.
# Production:  ALLOWED_ORIGINS=https://gmahk.flipus.org,https://app.flipus.org
# LAN origins (192.168.x.x, 10.x.x.x, 172.16-31.x.x) auto-allowed via regex
# untuk demo offline multi-device di Wi-Fi lokal — tidak perlu list di sini.
# JANGAN pakai '*' karena credentials=True (CORS spec violation, server drop).
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
# Rekomendasi: 15 min access + 7 day refresh (FASE 3-S3.S8)
