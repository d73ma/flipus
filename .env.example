# FLIPUS v1.2 — Environment variables
# Copy file ini ke .env lalu isi nilai yang sesuai

# ===== Security =====
# Generate dengan: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=ganti-dengan-random-string-min-32-char
PII_ENCRYPTION_KEY=ganti-dengan-fernet-key-dari-fernet.generate_key

# ===== Database =====
# Default SQLite untuk jemaat lokal
DATABASE_URL_LOCAL=sqlite:///./flipus_local.db
# Optional PostgreSQL untuk Kantor Misi/Uni
# DATABASE_URL_LOCAL=postgresql://flipus:flipus@postgres:5432/flipus
DATABASE_URL_CLOUD=postgresql://flipus:flipus@postgres:5432/flipus

# ===== WhatsApp (Fonnte) =====
# Daftar di https://fonnte.com, ambil token dari dashboard
FONNTE_TOKEN=your-fonnte-token-here
WA_API_URL=https://api.fonnte.com/send

# ===== AI (Gemini untuk OCR) =====
GEMINI_API_KEY=your-gemini-api-key-here

# ===== License =====
LICENSE_TENANT_SIGNATURE_SALT=UKIKT_FLIPUS_2026_NATAAN_RATAHAN_SALT

# ===== Application =====
DEFAULT_UNI=Uni Konferens Indonesia Kawasan Timur (UKIKT)
ACCESS_TOKEN_EXPIRE_MINUTES=480
